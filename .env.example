# Ballr - Environment Configuration

# Server
SERVER_PORT=:3000

# PostgreSQL
DATABASE_URL=host=localhost user=myuser password=mypassword dbname=mydb port=5432 sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# AWS S3
AWS_S3_ACCESS_KEY = "access key"
AWS_S3_SECRET_ACCESS_KEY = "secret access key"
S3_BUCKET = "ballr bucket"

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Cookies
COOKIE_SECURE=false

# LLM Provider for Coach (set one of these)
# OpenAI (or any OpenAI-compatible API like Ollama, vLLM, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Gemini
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash
# There will be custom models available in the future like mimo v2.5
